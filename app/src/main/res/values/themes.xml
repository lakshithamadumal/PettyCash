<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.PettyCashApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Remove all action bars -->
        <item name="windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:actionBarStyle">@null</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">#0f172a</item>

        <!-- Needed for fullscreen drawing -->
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>

        <!-- Optional: Navigation bar color (bottom) -->
        <item name="android:navigationBarColor">#0f172a</item>

    </style>

</resources>
